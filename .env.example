OPENAI_API_KEY=
JWT_SECRET=
# Domini del frontend autorizzati a chiamare questa API (CORS), separati da virgola
ORIGINI_CONSENTITE=http://localhost:3000
# Skill Alexa: chiave segreta condivisa con la Lambda della skill (header X-Api-Key)
# e id dell'utente RAG (vedi tabella Utente) a cui associare le domande fatte ad Alexa
ALEXA_API_KEY=
ALEXA_USER_ID=
# Tracing LangSmith (facoltativo): lasciare TRACING=false per tenerlo spento.
# ENDPOINT va valorizzato SOLO se l'account è sulla regione europea: il default
# della libreria punta agli Stati Uniti e con un account EU risponde 403.
# Reranking dei risultati con cross-encoder (vedi src/rag/reranking.py).
# SPENTO di default: con "off" l'app si comporta esattamente come prima che il
# reranker esistesse — nessun download, nessuna RAM in più, nessuna latenza.
#
# Con "on" un cross-encoder riordina i candidati del ranking ibrido leggendo
# domanda e chunk insieme; i boost su giorno/spesa/capitolo restano intatti.
# Aiuta soprattutto sui documenti senza boost dedicato (CCNL, codici).
#
# PRIMA DI ACCENDERLO, sappi che:
#  - il modello pesa ~2,3 GB, scaricati al primo avvio (minuti, non secondi);
#  - aggiunge ~1 s per domanda su CPU, che il grafo può pagare due volte;
#  - la skill Alexa lo salta comunque: chiude la connessione troppo presto.
RERANKER=off
# MODELLO_RERANKER=BAAI/bge-reranker-v2-m3
# Solo con RERANKER=on, e solo se il percorso è su un volume persistente e
# scrivibile: evita di riscaricare i 2,3 GB a ogni redeploy. Lasciata vuota,
# si usa la cache dell'immagine. NON impostarla a stringa vuota: HuggingFace
# la risolve nel path relativo "hub", che nel container è effimero.
# HF_HOME=/data/hf
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-allenamento
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
